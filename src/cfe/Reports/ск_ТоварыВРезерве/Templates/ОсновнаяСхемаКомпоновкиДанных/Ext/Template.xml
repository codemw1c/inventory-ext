	</totalField>
	<totalField>
		<dataPath>ОстатокНаСкладе</dataPath>
		<expression>Максимум(ОстатокНаСкладе)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>СвободныйОстаток</dataPath>
		<expression>Максимум(ОстатокНаСкладе) - Сумма(ВРезерве)</expression>
		<group>Номенклатура</group>
	</totalField>
