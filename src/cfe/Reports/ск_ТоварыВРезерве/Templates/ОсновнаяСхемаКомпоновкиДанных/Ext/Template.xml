			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВРезерве</dataPath>
			<field>ВРезерве</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>В резерве</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОстатокНаСкладе</dataPath>
			<field>ОстатокНаСкладе</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Остаток на складе</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Резервы.Склад КАК Склад,
	Резервы.Номенклатура КАК Номенклатура,
	Резервы.ДокументРезерва КАК ДокументРезерва,
	Резервы.КоличествоОстаток КАК ВРезерве
ПОМЕСТИТЬ ВТРезервы
ИЗ
	РегистрНакопления.ск_ТоварыВРезерве.Остатки(&amp;Период, {(Склад).*, (Номенклатура).*}) КАК Резервы
ГДЕ
	Резервы.КоличествоОстаток &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТРезервы.Склад КАК Склад,
	ВТРезервы.Номенклатура КАК Номенклатура,
	ВТРезервы.ДокументРезерва КАК ДокументРезерва,
	ВТРезервы.ВРезерве КАК ВРезерве,
	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокНаСкладе
ИЗ
	ВТРезервы КАК ВТРезервы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ск_ТоварыНаСкладах.Остатки(
				&amp;Период,
				(Номенклатура, Склад) В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						Т.Номенклатура,
						Т.Склад
					ИЗ
						ВТРезервы КАК Т)) КАК Остатки
		ПО ВТРезервы.Номенклатура = Остатки.Номенклатура
			И ВТРезервы.Склад = Остатки.Склад</query>
	</dataSet>
	<calculatedField>
		<dataPath>СвободныйОстаток</dataPath>
		<expression>ОстатокНаСкладе - ВРезерве</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
