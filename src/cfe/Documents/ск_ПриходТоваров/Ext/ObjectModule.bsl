#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Ключи = ск_СкладскойУчетСервер.КлючиОстатков(Ссылка, Склад, Товары);
	ск_СкладскойУчетСервер.ЗаблокироватьОстатки(Ключи);

	Движения.ск_ТоварыНаСкладах.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ск_ТоварыНаСкладах.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТоваров.Количество;
	КонецЦикла;
	Движения.Записать();

	// При перепроведении с меньшим количеством или другим складом остаток мог уйти в минус.
	ск_СкладскойУчетСервер.ПроверитьСвободныеОстатки(Ключи, Отказ);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Ключи = ск_СкладскойУчетСервер.КлючиОстатков(Ссылка, Склад, Товары);
	ск_СкладскойУчетСервер.ЗаблокироватьОстатки(Ключи);

	Движения.ск_ТоварыНаСкладах.Записывать = Истина;
	Движения.ск_ТоварыНаСкладах.Записать();

	ск_СкладскойУчетСервер.ПроверитьСвободныеОстатки(Ключи, Отказ);

КонецПроцедуры

#КонецОбласти

