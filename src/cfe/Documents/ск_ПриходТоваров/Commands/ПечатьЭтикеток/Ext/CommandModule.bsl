&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ТабличныйДокумент = ск_ПечатьЭтикетокВызовСервера.ЭтикеткиПоПриходам(ПараметрКоманды);
	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		ТабличныйДокумент.Показать(НСтр("ru = 'Этикетки по приходу товаров'"));
	КонецЕсли;

КонецПроцедуры
