#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ск_РезервТоваров") Тогда
		ЗаполнитьПоРезерву(ДанныеЗаполнения);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(ДокументРезерва) Тогда
		Возврат;
	КонецЕсли;

	РеквизитыРезерва = РеквизитыРезерва(ДокументРезерва);
	Если Не РеквизитыРезерва.Проведен Тогда
		ск_СкладскойУчетСервер.СообщитьПользователю(
			НСтр("ru = 'Указанный документ резерва не проведен.'"), "Объект.ДокументРезерва");
		Отказ = Истина;
	ИначеЕсли РеквизитыРезерва.Склад <> Склад Тогда
		ск_СкладскойУчетСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Резерв оформлен на склад ""%1"", а отгрузка — со склада ""%2"".'"),
				РеквизитыРезерва.Склад, Склад),
			"Объект.ДокументРезерва");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Ключи = ск_СкладскойУчетСервер.КлючиОстатков(Ссылка, Склад, Товары);
	ск_СкладскойУчетСервер.ЗаблокироватьОстатки(Ключи);

	// Резерв по документу читаем без собственных прошлых движений, поэтому сначала очищаем их.
	Движения.ск_ТоварыВРезерве.Записывать = Истина;
	Движения.ск_ТоварыВРезерве.Записать();

	Движения.ск_ТоварыНаСкладах.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ск_ТоварыНаСкладах.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТоваров.Количество;
	КонецЦикла;

	Если ЗначениеЗаполнено(ДокументРезерва) Тогда
		СнятьРезерв();
	КонецЕсли;

	Движения.ск_ТоварыВРезерве.Записывать = Истина;
	Движения.Записать();

	ск_СкладскойУчетСервер.ПроверитьСвободныеОстатки(Ключи, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Списывает резерв выбранного документа в пределах отгружаемого и еще не отгруженного количества.
Процедура СнятьРезерв()

	ОстаткиРезерва = ск_СкладскойУчетСервер.ОстаткиРезерва(ДокументРезерва);
	ОстаткиРезерва.Индексы.Добавить("Номенклатура");

	Отгрузка = Товары.Выгрузить(, "Номенклатура, Количество");
	Отгрузка.Свернуть("Номенклатура", "Количество");

	Для Каждого СтрокаОтгрузки Из Отгрузка Цикл
		СтрокаРезерва = ОстаткиРезерва.Найти(СтрокаОтгрузки.Номенклатура, "Номенклатура");
		Если СтрокаРезерва = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КоличествоСнятия = Мин(СтрокаОтгрузки.Количество, СтрокаРезерва.Количество);
		Если КоличествоСнятия <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.ск_ТоварыВРезерве.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаОтгрузки.Номенклатура;
		Движение.Склад = Склад;
		Движение.ДокументРезерва = ДокументРезерва;
		Движение.Количество = КоличествоСнятия;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПоРезерву(Резерв)

	РеквизитыРезерва = РеквизитыРезерва(Резерв);
	Если Не РеквизитыРезерва.Проведен Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 не проведен, отгрузка по нему невозможна.'"), Резерв);
	КонецЕсли;

	ОстаткиРезерва = ск_СкладскойУчетСервер.ОстаткиРезерва(Резерв);
	Если ОстаткиРезерва.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'По документу %1 не осталось неотгруженных товаров.'"), Резерв);
	КонецЕсли;

	Склад = РеквизитыРезерва.Склад;
	ДокументРезерва = Резерв;
	Товары.Загрузить(ОстаткиРезерва);

КонецПроцедуры

Функция РеквизитыРезерва(Резерв)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Резерв.Проведен КАК Проведен,
	|	Резерв.Склад КАК Склад
	|ИЗ
	|	Документ.ск_РезервТоваров КАК Резерв
	|ГДЕ
	|	Резерв.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Резерв);
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Структура("Проведен, Склад", Ложь, Справочники.ск_Склады.ПустаяСсылка());
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
