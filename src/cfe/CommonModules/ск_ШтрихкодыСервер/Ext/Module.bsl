///////////////////////////////////////////////////////////////////////////////
// Штрихкоды EAN-13: контрольная цифра, генерация внутренних кодов и построение изображения.
// Изображение строится средствами встроенного языка (BMP), без внешних компонент.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет, что строка является корректным штрихкодом EAN-13 (13 цифр и верная контрольная цифра).
//
// Параметры:
//   Штрихкод - Строка - проверяемый штрихкод.
//
// Возвращаемое значение:
//   Булево
//
Функция ШтрихкодEAN13Корректен(Знач Штрихкод) Экспорт

	Штрихкод = СокрЛП(Штрихкод);
	Если СтрДлина(Штрихкод) <> 13 Или Не ТолькоЦифры(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат КонтрольнаяЦифраEAN13(Лев(Штрихкод, 12)) = Число(Прав(Штрихкод, 1));

КонецФункции

// Рассчитывает контрольную цифру EAN-13 по первым 12 цифрам.
//
// Параметры:
//   Цифры12 - Строка - 12 цифр штрихкода.
//
// Возвращаемое значение:
//   Число - контрольная цифра 0..9.
//
Функция КонтрольнаяЦифраEAN13(Цифры12) Экспорт

	Сумма = 0;
	Для Позиция = 1 По 12 Цикл
		Цифра = Число(Сред(Цифры12, Позиция, 1));
		Сумма = Сумма + ?(Позиция % 2 = 0, Цифра * 3, Цифра);
	КонецЦикла;

	Возврат (10 - Сумма % 10) % 10;

КонецФункции

// Формирует внутренний (весовой/магазинный диапазон, префикс 2) штрихкод EAN-13 по коду номенклатуры:
// "2" + "00" + код из 9 цифр + контрольная цифра.
//
// Параметры:
//   КодНоменклатуры - Число - код элемента справочника.
//
// Возвращаемое значение:
//   Строка - штрихкод из 13 цифр.
//
Функция ВнутреннийШтрихкодEAN13(КодНоменклатуры) Экспорт

	Цифры12 = "200" + Формат(КодНоменклатуры, "ЧЦ=9; ЧВН=; ЧГ=0");
	Возврат Цифры12 + Формат(КонтрольнаяЦифраEAN13(Цифры12), "ЧН=0; ЧГ=0");

КонецФункции

// Строит изображение штрихкода EAN-13.
//
// Параметры:
//   Штрихкод - Строка - корректный штрихкод EAN-13.
//   ШиринаМодуля - Число - ширина одного модуля (самой тонкой полосы) в пикселях.
//   Высота - Число - высота изображения в пикселях.
//
// Возвращаемое значение:
//   Картинка - монохромное изображение штрихкода в формате BMP.
//
Функция КартинкаШтрихкодаEAN13(Штрихкод, ШиринаМодуля = 3, Высота = 80) Экспорт

	Модули = МодулиEAN13(Штрихкод);
	Возврат Новый Картинка(ИзображениеBMP(Модули, ШиринаМодуля, Высота));

КонецФункции

// Возвращает штрихкод в привычном для печати виде: "4 600000 000000".
//
// Параметры:
//   Штрихкод - Строка - штрихкод EAN-13.
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеШтрихкодаEAN13(Штрихкод) Экспорт

	Возврат Лев(Штрихкод, 1) + " " + Сред(Штрихкод, 2, 6) + " " + Сред(Штрихкод, 8, 6);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодирует EAN-13 в последовательность из 95 модулей: "1" — штрих, "0" — пробел.
Функция МодулиEAN13(Штрихкод)

	КодыL = СтрРазделить("0001101,0011001,0010011,0111101,0100011,0110001,0101111,0111011,0110111,0001011", ",");
	КодыG = СтрРазделить("0100111,0110011,0011011,0100001,0011101,0111001,0000101,0010001,0001001,0010111", ",");
	КодыR = СтрРазделить("1110010,1100110,1101100,1000010,1011100,1001110,1010000,1000100,1001000,1110100", ",");
	// Первая цифра кодируется не символом, а чередованием наборов L/G в левой половине.
	Четности = СтрРазделить("LLLLLL,LLGLGG,LLGGLG,LLGGGL,LGLLGG,LGGLLG,LGGGLL,LGLGLG,LGLGGL,LGGLGL", ",");

	Схема = Четности[Число(Лев(Штрихкод, 1))];

	Результат = "101";
	Для Позиция = 2 По 7 Цикл
		Цифра = Число(Сред(Штрихкод, Позиция, 1));
		Если Сред(Схема, Позиция - 1, 1) = "L" Тогда
			Результат = Результат + КодыL[Цифра];
		Иначе
			Результат = Результат + КодыG[Цифра];
		КонецЕсли;
	КонецЦикла;
	Результат = Результат + "01010";
	Для Позиция = 8 По 13 Цикл
		Результат = Результат + КодыR[Число(Сред(Штрихкод, Позиция, 1))];
	КонецЦикла;
	Результат = Результат + "101";

	Возврат Результат;

КонецФункции

// Формирует 24-битный BMP: полосы по маске модулей, по краям — свободная зона 9 модулей.
Функция ИзображениеBMP(Модули, ШиринаМодуля, Высота)

	СвободнаяЗона = 9;
	ВсегоМодулей = СтрДлина(Модули) + 2 * СвободнаяЗона;
	Ширина = ВсегоМодулей * ШиринаМодуля;
	РазмерСтроки = Цел((Ширина * 3 + 3) / 4) * 4; // строки BMP выравниваются на 4 байта
	РазмерДанных = РазмерСтроки * Высота;
	РазмерЗаголовка = 54;

	Буфер = Новый БуферДвоичныхДанных(РазмерЗаголовка + РазмерДанных, ПорядокБайтов.LittleEndian);

	// BITMAPFILEHEADER
	Буфер.Установить(0, 66); // "B"
	Буфер.Установить(1, 77); // "M"
	Буфер.ЗаписатьЦелое32(2, РазмерЗаголовка + РазмерДанных);
	Буфер.ЗаписатьЦелое32(10, РазмерЗаголовка);
	// BITMAPINFOHEADER
	Буфер.ЗаписатьЦелое32(14, 40);
	Буфер.ЗаписатьЦелое32(18, Ширина);
	Буфер.ЗаписатьЦелое32(22, Высота);
	Буфер.ЗаписатьЦелое16(26, 1);  // плоскости
	Буфер.ЗаписатьЦелое16(28, 24); // бит на пиксель
	Буфер.ЗаписатьЦелое32(34, РазмерДанных);
	Буфер.ЗаписатьЦелое32(38, 11811); // 300 dpi
	Буфер.ЗаписатьЦелое32(42, 11811);

	// Все строки изображения одинаковы: формируем одну и копируем.
	Строка = Новый БуферДвоичныхДанных(РазмерСтроки);
	Для НомерМодуля = 0 По ВсегоМодулей - 1 Цикл
		ИндексВКоде = НомерМодуля - СвободнаяЗона + 1;
		ЭтоШтрих = ИндексВКоде >= 1 И ИндексВКоде <= СтрДлина(Модули) И Сред(Модули, ИндексВКоде, 1) = "1";
		Цвет = ?(ЭтоШтрих, 0, 255);
		Для Пиксель = 0 По ШиринаМодуля - 1 Цикл
			Смещение = (НомерМодуля * ШиринаМодуля + Пиксель) * 3;
			Строка.Установить(Смещение, Цвет);
			Строка.Установить(Смещение + 1, Цвет);
			Строка.Установить(Смещение + 2, Цвет);
		КонецЦикла;
	КонецЦикла;

	Для НомерСтроки = 0 По Высота - 1 Цикл
		Буфер.Записать(РазмерЗаголовка + НомерСтроки * РазмерСтроки, Строка);
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Функция ТолькоЦифры(Строка)

	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
