///////////////////////////////////////////////////////////////////////////////
// Печать этикеток номенклатуры со штрихкодом EAN-13.
// Каждая этикетка выводится на отдельную страницу (типовой режим термопринтера этикеток).
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Формирует по одной этикетке на каждую переданную позицию номенклатуры.
//
// Параметры:
//   МассивНоменклатуры - Массив из СправочникСсылка.ск_Номенклатура
//
// Возвращаемое значение:
//   ТабличныйДокумент
//
Функция ЭтикеткиНоменклатуры(Знач МассивНоменклатуры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	1 КАК Количество
	|ИЗ
	|	Справочник.ск_Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивНоменклатуры)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);

	Возврат СформироватьЭтикетки(Запрос.Выполнить().Выгрузить());

КонецФункции

// Формирует этикетки по документам прихода: количество этикеток равно
// количеству товара в документе (дробное количество округляется вверх).
//
// Параметры:
//   МассивДокументов - Массив из ДокументСсылка.ск_ПриходТоваров
//
// Возвращаемое значение:
//   ТабличныйДокумент
//
Функция ЭтикеткиПоПриходам(Знач МассивДокументов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ск_ПриходТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В(&МассивДокументов)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);

	Возврат СформироватьЭтикетки(Запрос.Выполнить().Выгрузить());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//   Этикетки - ТаблицаЗначений - колонки Номенклатура, Количество.
Функция СформироватьЭтикетки(Этикетки)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ск_ЭтикеткиНоменклатуры";
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.АвтоМасштаб = Истина;

	Если Этикетки.Количество() = 0 Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.Штрихкод КАК Штрихкод
	|ИЗ
	|	Справочник.ск_Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивНоменклатуры)";
	Запрос.УстановитьПараметр("МассивНоменклатуры", Этикетки.ВыгрузитьКолонку("Номенклатура"));
	ДанныеНоменклатуры = Запрос.Выполнить().Выгрузить();
	ДанныеНоменклатуры.Индексы.Добавить("Ссылка");

	ПерваяЭтикетка = Истина;
	Для Каждого СтрокаЭтикетки Из Этикетки Цикл

		Данные = ДанныеНоменклатуры.Найти(СтрокаЭтикетки.Номенклатура, "Ссылка");
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не ск_ШтрихкодыСервер.ШтрихкодEAN13Корректен(Данные.Штрихкод) Тогда
			ск_СкладскойУчетСервер.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'У номенклатуры ""%1"" не заполнен корректный штрихкод EAN-13, этикетка не сформирована.'"),
				Данные.Наименование));
			Продолжить;
		КонецЕсли;

		ОбластьЭтикетки = ОбластьЭтикетки(Данные);
		КоличествоЭтикеток = ОкруглитьВверх(СтрокаЭтикетки.Количество);

		Для Номер = 1 По КоличествоЭтикеток Цикл
			Если Не ПерваяЭтикетка Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьЭтикетки);
			ПерваяЭтикетка = Ложь;
		КонецЦикла;

	КонецЦикла;

	ТабличныйДокумент.Область(, 1, , 1).ШиринаКолонки = ШиринаЭтикетки();

	Возврат ТабличныйДокумент;

КонецФункции

// Строит одну этикетку: наименование, артикул и код, изображение штрихкода, цифры штрихкода.
Функция ОбластьЭтикетки(Данные)

	Шаблон = Новый ТабличныйДокумент;
	Шаблон.Область(, 1, , 1).ШиринаКолонки = ШиринаЭтикетки();

	ОбластьНаименования = Шаблон.Область(1, 1);
	ОбластьНаименования.Текст = Данные.Наименование;
	ОбластьНаименования.Шрифт = Новый Шрифт("Arial", 11, Истина);
	ОбластьНаименования.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	ОбластьНаименования.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьНаименования.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	ОбластьНаименования.ВысотаСтроки = 30;

	Реквизиты = Новый Массив;
	Если ЗначениеЗаполнено(Данные.Артикул) Тогда
		Реквизиты.Добавить(СтрШаблон(НСтр("ru = 'Арт. %1'"), Данные.Артикул));
	КонецЕсли;
	Реквизиты.Добавить(СтрШаблон(НСтр("ru = 'Код %1'"), Формат(Данные.Код, "ЧГ=0")));
	Если ЗначениеЗаполнено(Данные.ЕдиницаИзмерения) Тогда
		Реквизиты.Добавить(Данные.ЕдиницаИзмерения);
	КонецЕсли;
	ОбластьРеквизитов = Шаблон.Область(2, 1);
	ОбластьРеквизитов.Текст = СтрСоединить(Реквизиты, "   ");
	ОбластьРеквизитов.Шрифт = Новый Шрифт("Arial", 8);
	ОбластьРеквизитов.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	ОбластьШтрихкода = Шаблон.Область(3, 1);
	ОбластьШтрихкода.ВысотаСтроки = 55;
	Рисунок = Шаблон.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = ск_ШтрихкодыСервер.КартинкаШтрихкодаEAN13(Данные.Штрихкод);
	Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
	Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
	Рисунок.Расположить(ОбластьШтрихкода);

	ОбластьЦифр = Шаблон.Область(4, 1);
	ОбластьЦифр.Текст = ск_ШтрихкодыСервер.ПредставлениеШтрихкодаEAN13(Данные.Штрихкод);
	ОбластьЦифр.Шрифт = Новый Шрифт("Arial", 10);
	ОбластьЦифр.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Шаблон.Область(1, 1, 4, 1).Обвести(Рамка, Рамка, Рамка, Рамка);

	Возврат Шаблон.ПолучитьОбласть("R1:R4");

КонецФункции

Функция ШиринаЭтикетки()

	Возврат 42;

КонецФункции

Функция ОкруглитьВверх(Количество)

	Результат = Цел(Количество);
	Если Результат < Количество Тогда
		Результат = Результат + 1;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
