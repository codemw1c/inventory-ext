///////////////////////////////////////////////////////////////////////////////
// Складской учет: блокировки и контроль остатков при проведении документов.
//
// Схема учета:
//   ск_ТоварыНаСкладах — физический остаток (Номенклатура, Склад);
//   ск_ТоварыВРезерве  — зарезервированное количество (Номенклатура, Склад, ДокументРезерва).
//   Свободный остаток = остаток на складе - резерв, он не может быть отрицательным.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает пары (Номенклатура, Склад), остатки по которым затрагивает документ:
// новые строки табличной части и уже записанные движения документа (склад или состав могли измениться).
//
// Параметры:
//   Ссылка  - ДокументСсылка - регистратор.
//   Склад   - СправочникСсылка.ск_Склады - склад документа.
//   Товары  - ТабличнаяЧасть - табличная часть с колонкой Номенклатура.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Номенклатура, Склад.
//
Функция КлючиОстатков(Ссылка, Склад, Товары) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Номенклатура КАК Номенклатура,
	|	&Склад КАК Склад
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Остатки.Номенклатура,
	|	Остатки.Склад
	|ИЗ
	|	РегистрНакопления.ск_ТоварыНаСкладах КАК Остатки
	|ГДЕ
	|	Остатки.Регистратор = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Резервы.Номенклатура,
	|	Резервы.Склад
	|ИЗ
	|	РегистрНакопления.ск_ТоварыВРезерве КАК Резервы
	|ГДЕ
	|	Резервы.Регистратор = &Ссылка";

	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить(, "Номенклатура"));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Устанавливает исключительные управляемые блокировки на остатки и резервы по ключам.
// Вызывается внутри транзакции проведения до чтения остатков.
//
// Параметры:
//   Ключи - ТаблицаЗначений - результат КлючиОстатков().
//
Процедура ЗаблокироватьОстатки(Ключи) Экспорт

	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из ИменаРегистровОстатков() Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Ключи;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Склад", "Склад");
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Проверяет после записи движений, что по каждому ключу остаток на складе не отрицательный
// и не меньше зарезервированного количества. При нарушении сообщает пользователю и устанавливает Отказ.
//
// Параметры:
//   Ключи - ТаблицаЗначений - результат КлючиОстатков().
//   Отказ - Булево - флаг отказа от проведения.
//
Процедура ПроверитьСвободныеОстатки(Ключи, Отказ) Экспорт

	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Склад КАК Склад
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКлючи.Номенклатура КАК Номенклатура,
	|	ВТКлючи.Склад КАК Склад,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокНаСкладе,
	|	ЕСТЬNULL(Резервы.КоличествоОстаток, 0) КАК ВРезерве
	|ИЗ
	|	ВТКлючи КАК ВТКлючи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ск_ТоварыНаСкладах.Остатки(
	|				,
	|				(Номенклатура, Склад) В
	|					(ВЫБРАТЬ
	|						ВТКлючи.Номенклатура,
	|						ВТКлючи.Склад
	|					ИЗ
	|						ВТКлючи КАК ВТКлючи)) КАК Остатки
	|		ПО ВТКлючи.Номенклатура = Остатки.Номенклатура
	|			И ВТКлючи.Склад = Остатки.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РезервыОстатки.Номенклатура КАК Номенклатура,
	|			РезервыОстатки.Склад КАК Склад,
	|			СУММА(РезервыОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.ск_ТоварыВРезерве.Остатки(
	|					,
	|					(Номенклатура, Склад) В
	|						(ВЫБРАТЬ
	|							ВТКлючи.Номенклатура,
	|							ВТКлючи.Склад
	|						ИЗ
	|							ВТКлючи КАК ВТКлючи)) КАК РезервыОстатки
	|		СГРУППИРОВАТЬ ПО
	|			РезервыОстатки.Номенклатура,
	|			РезервыОстатки.Склад) КАК Резервы
	|		ПО ВТКлючи.Номенклатура = Резервы.Номенклатура
	|			И ВТКлючи.Склад = Резервы.Склад
	|ГДЕ
	|	(ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < 0
	|			ИЛИ ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < ЕСТЬNULL(Резервы.КоличествоОстаток, 0))";

	Запрос.УстановитьПараметр("Ключи", Ключи);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Нехватка = Макс(Выборка.ВРезерве, 0) - Выборка.ОстатокНаСкладе;
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Недостаточно свободного остатка товара ""%1"" на складе ""%2"": на складе %3, в резерве %4, не хватает %5.'"),
			Выборка.Номенклатура,
			Выборка.Склад,
			Выборка.ОстатокНаСкладе,
			Выборка.ВРезерве,
			Нехватка);
		СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

// Проверяет, что по документу резерва не отгружено больше, чем зарезервировано
// (актуально при перепроведении или отмене проведения резерва после частичной отгрузки).
//
// Параметры:
//   ДокументРезерва - ДокументСсылка.ск_РезервТоваров - проверяемый резерв.
//   Отказ - Булево - флаг отказа.
//
Процедура ПроверитьОстаткиРезерва(ДокументРезерва, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Резервы.Номенклатура КАК Номенклатура,
	|	-Резервы.КоличествоОстаток КАК УжеОтгружено
	|ИЗ
	|	РегистрНакопления.ск_ТоварыВРезерве.Остатки(, ДокументРезерва = &ДокументРезерва) КАК Резервы
	|ГДЕ
	|	Резервы.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("ДокументРезерва", ДокументРезерва);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'По резерву уже отгружено больше товара ""%1"", чем останется зарезервировано (превышение %2).'"),
			Выборка.Номенклатура,
			Выборка.УжеОтгружено);
		СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

// Возвращает неотгруженный остаток по документу резерва.
//
// Параметры:
//   ДокументРезерва - ДокументСсылка.ск_РезервТоваров - резерв.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Номенклатура, Количество (только положительные остатки).
//
Функция ОстаткиРезерва(ДокументРезерва) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Резервы.Номенклатура КАК Номенклатура,
	|	Резервы.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ск_ТоварыВРезерве.Остатки(, ДокументРезерва = &ДокументРезерва) КАК Резервы
	|ГДЕ
	|	Резервы.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Резервы.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("ДокументРезерва", ДокументРезерва);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Выводит сообщение пользователю.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//   Поле  - Строка - путь к полю формы (необязательный).
//
Процедура СообщитьПользователю(Текст, Поле = "") Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаРегистровОстатков()

	Имена = Новый Массив;
	Имена.Добавить("ск_ТоварыНаСкладах");
	Имена.Добавить("ск_ТоварыВРезерве");
	Возврат Имена;

КонецФункции

#КонецОбласти
