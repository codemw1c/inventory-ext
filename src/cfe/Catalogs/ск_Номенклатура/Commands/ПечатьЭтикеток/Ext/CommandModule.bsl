&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ТабличныйДокумент = ск_ПечатьЭтикетокВызовСервера.ЭтикеткиНоменклатуры(ПараметрКоманды);
	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		ТабличныйДокумент.Показать(НСтр("ru = 'Этикетки номенклатуры'"));
	КонецЕсли;

КонецПроцедуры
