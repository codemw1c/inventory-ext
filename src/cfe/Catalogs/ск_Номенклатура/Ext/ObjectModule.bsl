#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		ЕдиницаИзмерения = НСтр("ru = 'шт'");
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	// Штрихкод уникален для позиции, у копии он сформируется заново.
	Штрихкод = "";

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Если Не ск_ШтрихкодыСервер.ШтрихкодEAN13Корректен(Штрихкод) Тогда
		ск_СкладскойУчетСервер.СообщитьПользователю(
			НСтр("ru = 'Штрихкод должен состоять из 13 цифр с верной контрольной цифрой (EAN-13).'"),
			"Объект.Штрихкод");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ск_Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Штрихкод = &Штрихкод
	|	И Номенклатура.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ск_СкладскойУчетСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Штрихкод %1 уже присвоен номенклатуре ""%2"".'"), Штрихкод, Выборка.Наименование),
			"Объект.Штрихкод");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Если Не ЗначениеЗаполнено(Код) Тогда
			УстановитьНовыйКод();
		КонецЕсли;
		Штрихкод = ск_ШтрихкодыСервер.ВнутреннийШтрихкодEAN13(Код);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
